{
  "$ref": "#/definitions/SaveFileData",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AppState": {
      "additionalProperties": false,
      "properties": {
        "pokemons": {
          "items": {
            "$ref": "#/definitions/Pokemon"
          },
          "type": "array"
        },
        "tasks": {
          "items": {
            "$ref": "#/definitions/Task"
          },
          "type": "array"
        },
        "totalTasksCompleted": {
          "type": "number"
        }
      },
      "required": ["tasks", "pokemons", "totalTasksCompleted"],
      "type": "object"
    },
    "Pokemon": {
      "additionalProperties": false,
      "properties": {
        "capturedAt": {
          "type": "number"
        },
        "experience": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "level": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "species": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "level",
        "experience",
        "capturedAt",
        "reward",
        "species"
      ],
      "type": "object"
    },
    "SaveFileData": {
      "additionalProperties": false,
      "properties": {
        "exportedAt": {
          "type": "number"
        },
        "state": {
          "$ref": "#/definitions/AppState"
        },
        "version": {
          "description": "Version of the save file format. This can be used to handle migrations in future updates.",
          "type": "string"
        }
      },
      "required": ["version", "exportedAt", "state"],
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "completed": {
          "type": "boolean"
        },
        "completedAt": {
          "type": "number"
        },
        "createdAt": {
          "type": "number"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "reward": {
          "type": "string"
        }
      },
      "required": ["id", "title", "completed", "createdAt", "reward"],
      "type": "object"
    }
  }
}
